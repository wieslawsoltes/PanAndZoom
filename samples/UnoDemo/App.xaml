<Application x:Class="UnoDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:UnoDemo.Converters"
             RequestedTheme="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- WinUI bindings have no StringFormat: format numbers with a converter instead. -->
      <converters:StringFormatConverter x:Key="StringFormat" />
      <!-- Two-way TextBox.Text <-> double/int conversion (Avalonia binds TextBox.Text to numbers directly). -->
      <converters:NumberToStringConverter x:Key="DoubleText" />
      <converters:NumberToStringConverter x:Key="IntText" IsInteger="True" />
      <!-- Equivalent of the Avalonia StringConverters.IsNotNullOrEmpty converter. -->
      <converters:StringIsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />

      <!-- Equivalent of the Avalonia Separator control. -->
      <Style x:Key="SeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="#FFD0D0D0" />
      </Style>

      <!-- Left hand settings panel of every demo page. -->
      <Style x:Key="DemoPanelScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>

      <!-- Border hosting the ZoomBorder of every demo page. -->
      <Style x:Key="DemoZoomBorderHostStyle" TargetType="Border">
        <Setter Property="Margin" Value="12" />
        <Setter Property="BorderBrush" Value="Gray" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>

</Application>
