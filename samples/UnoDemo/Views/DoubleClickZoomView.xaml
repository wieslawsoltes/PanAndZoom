<UserControl x:Class="UnoDemo.Views.DoubleClickZoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paz="using:PanAndZoom">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Controls -->
    <ScrollViewer Grid.Column="0" Style="{StaticResource DemoPanelScrollViewerStyle}">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock Text="Double Click Zoom" FontWeight="Bold" FontSize="16" />
        <TextBlock Text="Configure double-click behavior" TextWrapping="Wrap" />

        <Border Style="{StaticResource SeparatorStyle}" Margin="0,8" />

        <TextBlock Text="Settings:" FontWeight="SemiBold" />
        <CheckBox Content="Enable Double Click Zoom" IsChecked="{Binding EnableDoubleClickZoom, Mode=TwoWay}" />

        <TextBlock Text="Double Click Mode:" Margin="0,8,0,0" />
        <!-- ItemsSource (the DoubleClickZoomMode values) is set in code behind. -->
        <ComboBox x:Name="DoubleClickModeCombo"
                  HorizontalAlignment="Stretch"
                  SelectedItem="{Binding DoubleClickZoomMode, Mode=TwoWay}" />

        <TextBlock Text="Zoom Factor:" Margin="0,8,0,0" />
        <TextBox Text="{Binding DoubleClickZoomFactor, Mode=TwoWay, Converter={StaticResource DoubleText}}" />

        <Border Style="{StaticResource SeparatorStyle}" Margin="0,8" />

        <TextBlock FontSize="11" TextWrapping="Wrap"
                   Text="Double-click on the content area to test the behavior. ZoomInOut alternates between zooming in and out." />
      </StackPanel>
    </ScrollViewer>

    <!-- ZoomBorder -->
    <Border Grid.Column="1" Style="{StaticResource DemoZoomBorderHostStyle}">
      <paz:ZoomBorder x:Name="ZoomBorder"
                      Stretch="Uniform"
                      ZoomSpeed="1.2"
                      Background="SlateBlue"
                      ClipToBounds="True"
                      EnableDoubleClickZoom="True"
                      DoubleClickZoomMode="ZoomInOut"
                      DoubleClickZoomFactor="2.0">
        <Canvas Width="500" Height="400" Background="LightGray">
          <TextBlock Canvas.Left="20" Canvas.Top="20" Text="Double-Click Anywhere!" FontSize="24" FontWeight="Bold" />

          <Border Canvas.Left="50" Canvas.Top="80" Width="200" Height="140"
                  Background="Red" BorderBrush="DarkRed" BorderThickness="2" Padding="10">
            <StackPanel>
              <TextBlock Text="Area 1" FontSize="16" FontWeight="Bold" />
              <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Text="Double-click here to zoom in/out" />
            </StackPanel>
          </Border>

          <Border Canvas.Left="300" Canvas.Top="80" Width="150" Height="140"
                  Background="Blue" BorderBrush="DarkBlue" BorderThickness="2" Padding="10">
            <StackPanel>
              <TextBlock Text="Area 2" FontSize="16" FontWeight="Bold" Foreground="White" />
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="White" Margin="0,4,0,0" Text="Test here too!" />
            </StackPanel>
          </Border>
        </Canvas>
      </paz:ZoomBorder>
    </Border>
  </Grid>

</UserControl>
