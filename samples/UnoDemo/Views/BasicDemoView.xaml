<UserControl x:Class="UnoDemo.Views.BasicDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paz="using:PanAndZoom">

  <!--
    The "Basic Demo" tab of the Avalonia MainView (DockPanel: settings left, state right, ZoomBorder fill).
    Avalonia hosts the ZoomBorder in a ScrollViewer and the ZoomBorder acts as its ILogicalScrollable;
    WinUI has no logical scrolling contract, so the ZoomBorder scroll state (Extent/Viewport/ScrollOffset)
    drives two ScrollBars instead (see code behind).
  -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Left: settings bound to the ZoomBorder (DataContext set in code behind) -->
    <ScrollViewer Grid.Column="0" Margin="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
        <StackPanel x:Name="SettingsPanel" Spacing="4">
          <StackPanel>
            <TextBlock Text="PanButton:" />
            <ComboBox x:Name="PanButtonCombo" SelectedItem="{Binding PanButton, Mode=TwoWay}" MinWidth="160" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Stretch:" />
            <ComboBox x:Name="StretchCombo" SelectedItem="{Binding Stretch, Mode=TwoWay}" MinWidth="160" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="PowerFactor:" />
            <TextBox Text="{Binding PowerFactor, Mode=TwoWay, Converter={StaticResource DoubleText}}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="ZoomSpeed:" />
            <TextBox Text="{Binding ZoomSpeed, Mode=TwoWay, Converter={StaticResource DoubleText}}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding EnablePan, Mode=TwoWay}" Content="EnablePan" />
          <CheckBox IsChecked="{Binding EnableZoom, Mode=TwoWay}" Content="EnableZoom" />
          <CheckBox IsChecked="{Binding EnableConstrains, Mode=TwoWay}" Content="EnableConstrains" />
          <CheckBox IsChecked="{Binding EnableGestures, Mode=TwoWay}" Content="EnableGestures" />
        </StackPanel>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="F - Fill" />
          <TextBlock Text="U - Uniform" />
          <TextBlock Text="R - Reset" />
          <TextBlock Text="T - Toggle Stretch Mode" />
          <TextBlock Text="Mouse Wheel - Zoom to Point" />
          <TextBlock Text="Mouse Left Button Down - Pan" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: current zoom and offset -->
    <ScrollViewer Grid.Column="2" Margin="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel x:Name="StatePanel" Width="120">
        <StackPanel>
          <TextBlock Text="ZoomX:" />
          <TextBlock Text="{Binding ZoomX}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="ZoomY:" />
          <TextBlock Text="{Binding ZoomY}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="OffsetX:" />
          <TextBlock Text="{Binding OffsetX}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="OffsetY:" />
          <TextBlock Text="{Binding OffsetY}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Center: ZoomBorder with scroll bars -->
    <Grid Grid.Column="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <paz:ZoomBorder x:Name="ZoomBorder1"
                      Stretch="None"
                      ZoomSpeed="1.5"
                      EnableConstrains="False"
                      EnableGestures="True"
                      Background="SlateBlue" ClipToBounds="True" IsTabStop="True"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Background="Gray" BorderBrush="Yellow" BorderThickness="10" Width="400" Height="400">
          <Canvas Background="LightGray" Width="300" Height="300">
            <Rectangle Canvas.Left="125" Canvas.Top="125" Width="50" Height="50" Fill="Red" />
            <StackPanel Canvas.Left="100" Canvas.Top="200">
              <!-- WinUI TextBlock has no Background: wrap it in a Border. -->
              <Border Width="100" Background="Red">
                <TextBlock Text="Text1" Foreground="WhiteSmoke" />
              </Border>
              <Border Width="100" Background="Red">
                <TextBlock Text="Text2" Foreground="WhiteSmoke" />
              </Border>
            </StackPanel>
            <!-- Avalonia binds the ResetMatrix method: Command="{Binding #ZoomBorder1.ResetMatrix}". -->
            <Button Content="Reset Zoom"
                    Command="{Binding ResetCommand, ElementName=ZoomBorder1}"
                    Width="120" Canvas.Left="100" Canvas.Top="250" />
            <!-- Avalonia ListBox -> WinUI ListView (ItemsSource set in code behind). -->
            <ListView x:Name="StretchList"
                      Width="120"
                      Canvas.Left="10" Canvas.Top="10"
                      Background="White"
                      SelectionMode="Single"
                      SelectedItem="{Binding Stretch, ElementName=ZoomBorder1, Mode=TwoWay}" />
            <ListView x:Name="PanButtonList"
                      Width="120"
                      Canvas.Left="160" Canvas.Top="10"
                      Background="White"
                      SelectionMode="Single"
                      SelectedItem="{Binding PanButton, ElementName=ZoomBorder1, Mode=TwoWay}" />
          </Canvas>
        </Border>
      </paz:ZoomBorder>

      <ScrollBar x:Name="VerticalBar"
                 Grid.Row="0" Grid.Column="1"
                 Orientation="Vertical"
                 IndicatorMode="MouseIndicator"
                 Minimum="0"
                 Visibility="Collapsed" />
      <ScrollBar x:Name="HorizontalBar"
                 Grid.Row="1" Grid.Column="0"
                 Orientation="Horizontal"
                 IndicatorMode="MouseIndicator"
                 Minimum="0"
                 Visibility="Collapsed" />
    </Grid>
  </Grid>

</UserControl>
