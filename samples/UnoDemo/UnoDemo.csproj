<Project Sdk="Uno.Sdk">

  <!--
    Uno Platform port of the Avalonia PanAndZoom demo (samples/AvaloniaDemo.Base + samples/AvaloniaDemo.Desktop).

    Run it with:
      dotnet run -f net10.0-desktop

    Smoke test every demo page (CI friendly, exits with a non-zero code on failure):
      UNODEMO_SELFTEST=1 dotnet run -f net10.0-desktop
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100</TargetFrameworks>
    <!-- Allows fast local builds, e.g. dotnet build -p:UnoDemoTargetFrameworks=net10.0-desktop -->
    <TargetFrameworks Condition="'$(UnoDemoTargetFrameworks)' != ''">$(UnoDemoTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>UnoDemo</RootNamespace>

    <ApplicationTitle>PanAndZoom Uno Demo</ApplicationTitle>
    <ApplicationId>com.wieslawsoltes.panandzoom.unodemo</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Wiesław Šoltés</ApplicationPublisher>
    <Description>Easily add pan and zoom functionality to your Uno Platform apps using the ZoomBorder control.</Description>

    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>

    <!-- Uno0001: API not implemented on some Uno targets (reported per target by the Uno analyzers). -->
    <NoWarn>$(NoWarn);Uno0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PanAndZoom.Uno\PanAndZoom.Uno.csproj" />
  </ItemGroup>

</Project>
